---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Nosotros | Agua Pura Colombia - Historia e Innovación" activePage="nosotros">
  <style>
    .story-hero {
      height: 90vh;
      display: flex;
      align-items: flex-end;
      padding-bottom: 10vh;
      background: linear-gradient(180deg, rgba(10,18,20,0.2) 0%, var(--background) 95%),
                  url('/images/chococol/nosotros-hero.jpeg') center/cover no-repeat;
      position: relative;
    }
    
    .phd-card {
      position: relative;
      padding: 48px 40px;
      background: linear-gradient(145deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0) 100%);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: all 0.4s ease;
    }

    .phd-card:hover {
      border-color: rgba(0, 240, 255, 0.3);
      transform: translateY(-8px);
      box-shadow: 0 12px 40px rgba(0, 240, 255, 0.08);
      background: linear-gradient(145deg, rgba(0, 240, 255, 0.05) 0%, rgba(255,255,255,0) 100%);
    }

    .phd-number {
      position: absolute;
      top: -10px;
      right: -10px;
      font-family: var(--font-display);
      font-size: 140px;
      font-weight: 800;
      color: rgba(255,255,255,0.02);
      line-height: 1;
      pointer-events: none;
      transition: color 0.4s ease;
    }

    .phd-card:hover .phd-number {
      color: rgba(0, 240, 255, 0.05);
    }

    .phd-icon {
      font-size: 32px;
      color: var(--primary);
      margin-bottom: 24px;
      display: block;
    }

    .leadership-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 64px;
    }

    @media(min-width: 992px) {
      .leadership-grid {
        grid-template-columns: 1.2fr 1fr;
      }
    }

    .leader-featured {
      padding: 56px 48px;
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.05) 0%, rgba(0,0,0,0) 100%);
      border: 1px solid rgba(0, 240, 255, 0.15);
      border-radius: var(--radius-xl);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .leader-stack {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .leader-card {
      padding: 40px;
      border-radius: var(--radius-lg);
      background: var(--surface-container);
      border: 1px solid rgba(255,255,255,0.03);
      display: flex;
      flex-direction: column;
      justify-content: center;
      flex: 1;
    }
  </style>

  <!-- ═══════════ HERO: LA VISIÓN ═══════════ -->
  <section class="story-hero">
    <div class="container">
      <div style="max-width: 900px;">
        <span class="image-caption">Nuestra Identidad</span>
        <h1 class="narrative-title text-white">Transformando el futuro a través de la <span class="text-primary">ciencia aplicada.</span></h1>
        <p class="editorial-text">AguaPura Colombia nace de una visión profundamente humana: devolverle la vida a nuestros ríos mediante el rigor científico y la innovación sostenible.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════ ESCENA 1: EL PROPÓSITO ═══════════ -->
  <section class="story-section">
    <div class="container">
      <div class="grid" style="grid-template-columns: 7fr 5fr; gap: 100px; align-items: center;">
        <div>
          <h2 class="text-headline-xl text-white">Compromiso con la <br><span class="text-primary">Salud Ambiental</span></h2>
          <p class="editorial-text" style="margin-top: 32px;">
            Fusionamos estrategias globales con raíces locales para enfrentar la remediación de metales pesados en las cuencas vitales de Colombia, asegurando un futuro hídrico seguro.
          </p>
          <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 64px;">
            <div>
              <h4 class="text-headline-md text-white">Misión</h4>
              <p class="text-body-md text-muted" style="margin-top: 12px;">Soluciones técnicas que mejoren la salud ambiental y la calidad de vida en las comunidades.</p>
            </div>
            <div>
              <h4 class="text-headline-md text-white">Visión</h4>
              <p class="text-body-md text-muted" style="margin-top: 12px;">Ser el referente regional en ingeniería ambiental de vanguardia para la purificación hídrica.</p>
            </div>
          </div>
        </div>
        <div class="glass-panel" style="padding: 0; overflow: hidden; border-radius: var(--radius-xl);">
          <img src="images/chococol/nosotros.jpeg" alt="Comunidad y Propósito" style="width: 100%; height: 600px; object-fit: cover;" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ ESCENA 2: LA CIENCIA (PHDs) ═══════════ -->
  <section class="story-section" style="background: rgba(255,255,255,0.02);">
    <div class="container">
      <div class="text-center" style="margin-bottom: 80px;">
        <span class="image-caption">Autoridad Científica</span>
        <h2 class="narrative-title text-white">Expertos a la Vanguardia de la <br><span class="text-primary">Tecnología Ambiental</span></h2>
      </div>
      
      <div class="grid" style="grid-template-columns: repeat(3, 1fr); gap: 32px;">
        <div class="phd-card">
          <span class="phd-number">01</span>
          <span class="material-symbols-outlined phd-icon">science</span>
          <h4 class="text-headline-md text-white">Dr. Shameem Hasan</h4>
          <p class="text-label-caps text-primary" style="margin-bottom: 20px;">Ph.D. • Tratamiento de Aguas</p>
          <p class="text-body-sm text-muted">Innovador en gestión de aguas residuales y poseedor de múltiples patentes en los Estados Unidos.</p>
        </div>
        <div class="phd-card">
          <span class="phd-number">02</span>
          <span class="material-symbols-outlined phd-icon">military_tech</span>
          <h4 class="text-headline-md text-white">Dr. Veera M. Boddu</h4>
          <p class="text-label-caps text-primary" style="margin-bottom: 20px;">Ph.D. • Ing. Química (US Army)</p>
          <p class="text-body-sm text-muted">Investigador líder con más de 100 publicaciones. Experto en el uso de biochar y nanomateriales para descontaminación profunda.</p>
        </div>
        <div class="phd-card">
          <span class="phd-number">03</span>
          <span class="material-symbols-outlined phd-icon">blur_on</span>
          <h4 class="text-headline-md text-white">Dr. Rafi M. Iasir</h4>
          <p class="text-label-caps text-primary" style="margin-bottom: 20px;">Ph.D. • Nanotecnología</p>
          <p class="text-body-sm text-muted">Especialista en desarrollo de materiales de vanguardia para la remoción eficiente de metales pesados en ríos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ ESCENA 3: DIRECCIÓN Y GESTIÓN ═══════════ -->
  <section class="story-section">
    <div class="container">
      <div class="text-center" style="margin-bottom: 48px;">
        <span class="image-caption">Liderazgo Estratégico</span>
        <h2 class="text-headline-xl text-white">Visión y <span class="text-primary">Ejecución</span></h2>
      </div>
      
      <div class="leadership-grid">
        <div class="leader-featured">
          <span class="material-symbols-outlined text-primary" style="font-size: 48px; margin-bottom: 24px;">psychology</span>
          <h4 class="text-headline-lg text-white">Rubén D. Salazar</h4>
          <p class="text-label-caps text-primary" style="margin-bottom: 24px;">Manager & CBC</p>
          <p class="editorial-text">Fusiona estrategias corporativas con una visión emprendedora para liderar soluciones ambientales efectivas y empáticas. Su enfoque garantiza que la innovación científica se traduzca en impacto real para las comunidades.</p>
        </div>
        <div class="leader-stack">
          <div class="leader-card">
            <span class="material-symbols-outlined text-muted" style="margin-bottom: 16px;">agriculture</span>
            <h4 class="text-headline-md text-white">Emilio Torres L.</h4>
            <p class="text-label-caps text-primary" style="margin-bottom: 12px;">Ingeniero (U. de Caldas)</p>
            <p class="text-body-sm text-muted">Aporta su vasta experiencia en agricultura y educación para integrar soluciones técnicas en el campo colombiano.</p>
          </div>
          <div class="leader-card">
            <span class="material-symbols-outlined text-muted" style="margin-bottom: 16px;">account_balance</span>
            <h4 class="text-headline-md text-white">Dra. Malka Sierra</h4>
            <p class="text-label-caps text-primary" style="margin-bottom: 12px;">Especialista en Gestión Pública</p>
            <p class="text-body-sm text-muted">Asegura una gestión eficiente y responsable ante los entes gubernamentales y sectores públicos.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ ESCENA 4: EL MODELO BIC ═══════════ -->
  <section class="story-section" style="padding-top: 0;">
    <div class="container">
      <div class="bic-display">
        <div class="grid" style="grid-template-columns: 5fr 7fr; gap: 80px; align-items: center;">
          <div>
            <span class="image-caption">Impacto Colectivo</span>
            <h2 class="text-headline-xl text-white">Nuestro Modelo <span class="text-primary">BIC</span></h2>
            <p class="editorial-text" style="margin-top: 24px; font-size: 18px;">
              Como Sociedad de Beneficio e Interés Colectivo, operamos bajo tres pilares fundamentales que garantizan que nuestro impacto positivo sea real, medible y sostenible:
            </p>
            <div style="margin-top: 40px; display: flex; flex-direction: column; gap: 24px;">
              <div style="display:flex; gap:16px;">
                <span class="material-symbols-outlined text-primary" style="font-size: 32px;">handshake</span>
                <div>
                  <h5 class="text-white" style="font-size:18px; margin-bottom: 4px;">Responsabilidad Social</h5>
                  <p class="text-body-sm text-muted">Trabajamos estrechamente con las comunidades locales, generando empleo y mejorando la salud pública al garantizar el acceso a fuentes de agua libres de metales pesados.</p>
                </div>
              </div>
              <div style="display:flex; gap:16px;">
                <span class="material-symbols-outlined text-primary" style="font-size: 32px;">eco</span>
                <div>
                  <h5 class="text-white" style="font-size:18px; margin-bottom: 4px;">Sostenibilidad Ambiental</h5>
                  <p class="text-body-sm text-muted">Implementamos economía circular transformando residuos agrícolas en biochar para la remediación activa de ríos y ecosistemas afectados por la minería.</p>
                </div>
              </div>
              <div style="display:flex; gap:16px;">
                <span class="material-symbols-outlined text-primary" style="font-size: 32px;">attach_money</span>
                <div>
                  <h5 class="text-white" style="font-size:18px; margin-bottom: 4px;">Viabilidad Económica</h5>
                  <p class="text-body-sm text-muted">Desarrollamos un modelo de negocio rentable y escalable que genera valor para los inversores sin comprometer nuestro propósito de regeneración y ética ambiental.</p>
                </div>
              </div>
            </div>
          </div>
          <div style="display: flex; justify-content: center; align-items: center;">
            <div style="position: relative; width: 65%; cursor: zoom-in;" id="diagram-trigger">
              <img src="images/chococol/diagrama-bic.webp" alt="Modelo BIC" style="width: 100%; filter: drop-shadow(0 0 30px rgba(0,240,255,0.1)); transition: transform 0.4s ease;" />
              <div style="position: absolute; bottom: 24px; right: 24px; background: rgba(0,240,255,0.1); border: 1px solid var(--primary); color: var(--primary); padding: 8px 16px; border-radius: 20px; font-size: 12px; display: flex; align-items: center; gap: 8px; backdrop-filter: blur(4px); pointer-events: none;">
                <span class="material-symbols-outlined" style="font-size: 16px;">zoom_in</span> Ampliar
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ CTA GRANDE ═══════════ -->
  <section class="big-cta-section" style="margin-top: 64px;">
    <div class="container" style="text-align:center; position:relative; z-index:2;">
      <h2 class="text-headline-xl text-white" style="font-style:italic; font-weight:800;">
        Sé parte de la <span class="text-primary glow-text">Solución</span>
      </h2>
      <p class="text-body-lg" style="max-width:700px; margin:24px auto 40px; color: rgba(255,255,255,0.7);">
        Ya sea que busques implementar remediación ambiental en tu industria o quieras colaborar con nuestro modelo regenerativo, estamos listos para trabajar juntos.
      </p>
      <a href="#contacto" class="btn btn-primary" style="padding:18px 48px;">Inicia un Proyecto</a>
    </div>
  </section>

  <!-- ═══════════ IMAGE MODAL (BIC) ═══════════ -->
  <div id="bic-modal" class="modal" role="dialog" aria-modal="true" aria-hidden="true" inert>
    <button class="modal-close" aria-label="Cerrar imagen ampliada" style="position:absolute; top:32px; right:32px; background:none; border:none; color:white; font-size:32px; cursor:pointer;">✕</button>
    <img src="images/chococol/diagrama-bic.webp" alt="Modelo BIC Ampliado" style="max-width: 90%; max-height: 90vh; object-fit: contain; filter: drop-shadow(0 0 40px rgba(0,240,255,0.2)); cursor: zoom-out;" id="diagram-image" />
  </div>

  <script>
    const trigger = document.getElementById('diagram-trigger');
    const modal = document.getElementById('bic-modal');
    const closeBtn = modal.querySelector('.modal-close');
    const img = document.getElementById('diagram-image');

    const openBicModal = () => {
      modal.classList.add('active');
      modal.removeAttribute('inert');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeBicModal = () => {
      modal.classList.remove('active');
      modal.setAttribute('inert', '');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    trigger?.addEventListener('click', openBicModal);
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeBicModal();
    });
    modal?.addEventListener('click', closeBicModal);
    img?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeBicModal();
    });
  </script>
</Layout>
